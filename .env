# Application env (updated)
ENV=development
PORT=8081

# Unicred / APIs
BASE_URL_UNICRED=https://servicos-tst.e-unicred.com.br
BASEAPI_URL=https://servicos-tst.e-unicred.com.br
UNICRED_OAUTH_URL=https://oauth-tst.e-unicred.com.br/auth/realms/UnicredRealm/protocol/openid-connect/token
URL_CONTA=conta-corrente-us/v2/contas-correntes
URL_CONTAS=conta-us/cadastro/conta
UNICRED_GRANT_TYPE=password
UNICRED_USERNAME=svc.integra.9008
UNICRED_PASSWORD=integra9008
UNICRED_CLIENT_SECRET=2b029892-56fa-4805-bc83-ada1956d96c8
UNICRED_CLIENT_ID=tst-client
URL_ASSOCIADO=pessoa-us/cadastro/pessoa/v1/associados
URL_CADASTRO_PF=cadastro-ufs/cadastro/pessoa-fisica/v1/pessoa-fisica

# Proposta-us e outros
BASEURL_PROPOSTA_US=https://servicos-tst.e-unicred.com.br/proposta-us
BASEURL_CONTA_CORRENTE_US=https://servicos-tst.e-unicred.com.br/conta-corrente-us
BASEURL_PESSOA_US=https://servicos-tst.e-unicred.com.br/pessoa-us
BASEURL_LINHA_CREDITO_US=https://servicos-tst.e-unicred.com.br/linha-credito-us
BASEURL_SEGURO_PRESTAMISTA_US=https://servicos-tst.e-unicred.com.br/seguro-prestamista-us

# Kafka (Primary = Unicred cluster)
KAFKA_BROKERS=bk01tst.e-unicred.com.br:9092,bk02tst.e-unicred.com.br:9092,bk03tst.e-unicred.com.br:9092,bk04tst.e-unicred.com.br:9092,bk05tst.e-unicred.com.br:9092
KAFKA_CLIENT_ID=proposal-facade
KAFKA_GROUP_ID=proposal-facade-group-01

# Topics:
# SOURCE_TOPIC = onde nós consumimos mensagens originadas no Unicred (ex.: crédito)
SOURCE_TOPIC=credito-notificacao-situacao-proposta-v1

# TARGET_TOPIC = tópico interno do ServiceNow (onde publicamos para SN streamconnect)
TARGET_TOPIC=snc.unicreddev.message.replication.test.sn.1

# DLQ for messages that failed when forwarding to SN
DLQ_TOPIC=snc.unicreddev.message.replication.test.sn.1

# Primary Kafka auth (if required)
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=svc-unicred
KAFKA_SASL_PASSWORD=topSecret

# PRODUCER -> usa 4000–4003; CONSUMER (se fizer no app) seria 4100–4103
KAFKA_SNOW_BROKERS=unicreddev.service-now.com:4000,unicreddev.service-now.com:4001,unicreddev.service-now.com:4002,unicreddev.service-now.com:4003
KAFKA_SNOW_CLIENT_ID=sn-connect

# TLS via P12 (keystore com client cert + key) + CA em PEM
KAFKA_SNOW_SSL_P12_PATH=C:\Develop\kafka_2.13-4.1.0\config\keystore-unicreddev.p12
KAFKA_SNOW_SSL_KEY_PASSPHRASE=z?,npA*y!235]Mit?Z`T              # <— tua senha
KAFKA_SNOW_SSL_CA_PATH=C:\Develop\kafka_2.13-4.1.0\config\truststore-ca.pem
KAFKA_SNOW_SSL_REJECT_UNAUTHORIZED=true

# Alternativa: PEM (se exportar do p12)
# KAFKA_SNOW_SSL_CERT_PATH=C:\...\client-cert.pem
# KAFKA_SNOW_SSL_KEY_PATH=C:\...\client-key.pem
# KAFKA_SNOW_SSL_KEY_PASSPHRASE=********
# KAFKA_SNOW_SSL_CA_PATH=C:\...\truststore-ca.pem

# SASL só se o cluster exigir (muitos ambientes do SN não pedem)
# KAFKA_SNOW_SASL_MECHANISM=PLAIN
# KAFKA_SNOW_SASL_USERNAME=svc-unicred
# KAFKA_SNOW_SASL_PASSWORD=********
